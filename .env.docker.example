# ==============================================================================
# VaptPDV — Variáveis de Ambiente de Exemplo para Orquestração Docker Compose
# Copie para .env na raiz do repositório antes de customizar senhas em produção.
# NUNCA versione arquivos .env com credenciais reais.
# ==============================================================================

# PostgreSQL (4 instâncias isoladas: postgres-core, postgres-kds, postgres-caixa, postgres-gestao)
POSTGRES_USER=vaptpdv
POSTGRES_PASSWORD=vaptpdv_secret
POSTGRES_DB_CORE=vaptpdv_db
POSTGRES_DB_KDS=kds_db
POSTGRES_DB_CAIXA=caixa_db
POSTGRES_DB_GESTAO=gestao_db

# Portas HTTP expostas no host
CORE_PORT=3000
KDS_PORT=3001
CAIXA_PORT=3002
GESTAO_PORT=3003

# Runtime Node.js / Fastify
NODE_ENV=production
LOG_LEVEL=info
