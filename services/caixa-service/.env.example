# Porta do caixa-service (canônica: 3002)
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# URL do banco exclusivo caixa_db (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/caixa_db?schema=public"

# URL do PDV Core para baixa atômica de estoque (:3000)
CORE_API_URL="http://localhost:3000"

# URL do gestao-service para envio de eventos (:3003)
GESTAO_API_URL="http://localhost:3003"
