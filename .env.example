# String de conexão do PostgreSQL (sem credenciais reais)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vapt_pdv?schema=public"

# Porta HTTP da aplicação
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Nível de log estruturado (Pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
