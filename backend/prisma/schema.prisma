generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  garcom
  caixa
  gerente
  cozinha
}

model Usuario {
  id            Int           @id @default(autoincrement())
  nome          String
  perfil        PerfilUsuario
  ativo         Boolean       @default(true)
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt

  @@map("usuarios")
}

model Produto {
  id             Int      @id @default(autoincrement())
  nome           String
  categoria      String
  preco          Decimal  @db.Decimal(10, 2)
  estoque        Int
  estoque_minimo Int      @default(0)
  ativo          Boolean  @default(true)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  @@map("produtos")
}

model MovimentoEstoque {
  id         Int      @id @default(autoincrement())
  produto_id Int
  quantidade Int
  motivo     String
  tipo       String?  @default("saida")
  comanda_id Int?
  criado_em  DateTime @default(now())

  @@index([comanda_id])
  @@index([produto_id])
  @@map("movimentos_estoque")
}

enum StatusComanda {
  aberta
  fechada
  paga
  cancelada
}

enum FormaPagamento {
  dinheiro
  pix
  cartao
}

model Comanda {
  id              Int             @id @default(autoincrement())
  mesa            Int
  nome_cliente    String?
  garcom_id       Int
  status          StatusComanda   @default(aberta)
  subtotal        Decimal?        @db.Decimal(10, 2)
  taxa_servico    Decimal?        @db.Decimal(10, 2)
  total           Decimal?        @db.Decimal(10, 2)
  forma_pagamento FormaPagamento?
  aberta_em       DateTime        @default(now())
  fechada_em      DateTime?
  paga_em         DateTime?
  cancelada_em    DateTime?
  motivo_cancelamento String?         @db.VarChar(240)
  itens           ItemComanda[]

  @@index([status])
  @@index([mesa])
  @@index([aberta_em])
  @@map("comandas")
}

model ItemComanda {
  id             Int     @id @default(autoincrement())
  comanda_id     Int
  produto_id     Int
  nome_copiado   String
  preco_copiado  Decimal @db.Decimal(10, 2)
  quantidade     Int
  observacao     String? @db.VarChar(240)
  status_preparo String  @default("recebido") @db.VarChar(20)
  comanda        Comanda @relation(fields: [comanda_id], references: [id], onDelete: Cascade)

  @@index([comanda_id])
  @@index([produto_id])
  @@map("itens_comanda")
}

model OutboxEvento {
  id            String    @id @default(uuid()) @map("id") @db.Uuid
  tipoEvento    String    @map("tipo_evento") @db.VarChar(60)
  chaveAgregado String    @map("chave_agregado") @db.VarChar(80)
  payload       Json      @map("payload")
  status        String    @default("PENDENTE") @map("status") @db.VarChar(20)
  tentativas    Int       @default(0) @map("tentativas")
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  publicadoEm   DateTime? @map("publicado_em") @db.Timestamptz(6)

  @@index([status, criadoEm(sort: Asc)], map: "outbox_pendentes_idx")
  @@map("outbox_eventos")
}

model EventoProcessado {
  eventoId     String   @id @map("evento_id") @db.Uuid
  evento       String   @db.VarChar(60)
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz(6)

  @@map("eventos_processados")
}
